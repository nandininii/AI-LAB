import random

def print_board(board):
    print("\n")
    for row in range(3):
        print(f"{board[row*3]} | {board[row*3+1]} | {board[row*3+2]}")
        if row < 2:
            print("---|---|---")
    print("\n")


def check_winner(board, player):
    win_conditions = [
        [0, 1, 2],
        [3, 4, 5],
        [6, 7, 8],
        [0, 3, 6],
        [1, 4, 7],
        [2, 5, 8],
        [0, 4, 8],
        [2, 4, 6]
    ]

    for condition in win_conditions:
        if (board[condition[0]] == board[condition[1]]
                == board[condition[2]] == player):
            return True

    return False


def is_full(board):
    return ' ' not in board


def tic_tac_toe():
    board = [' '] * 9

    print("Welcome to Tic Tac Toe")

    human_symbol = ''

    while human_symbol not in ['X', 'O']:
        human_symbol = input("Enter X or O: ").strip().upper()

        if human_symbol not in ['X', 'O']:
            print("Enter a valid symbol X or O")

    comp_symbol = 'O' if human_symbol == 'X' else 'X'

    print("Board positions are:")
    print("1 | 2 | 3")
    print("4 | 5 | 6")
    print("7 | 8 | 9")

    current_player = 'X'

    print(
        f"Your symbol : {human_symbol}\n"
        f"Computer symbol : {comp_symbol}"
    )

    while True:

        if human_symbol == current_player:
            try:
                move = int(input("Enter position (1-9): "))

                if move < 1 or move > 9 or board[move - 1] != ' ':
                    print("Enter a valid position")
                    continue

            except ValueError:
                print("Enter a valid integer (1-9)")
                continue

            board[move - 1] = human_symbol

        else:
            available_moves = [
                i for i in range(9)
                if board[i] == ' '
            ]

            move = random.choice(available_moves)
            board[move] = comp_symbol

        print_board(board)

        if check_winner(board, current_player):

            if current_player == human_symbol:
                print("Congrats! You win")

            elif current_player == comp_symbol:
                print("Computer wins")

            break

        if is_full(board):
            print("It's a draw")
            break

        current_player = 'O' if current_player == 'X' else 'X'


if __name__ == "__main__":
    tic_tac_toe()

